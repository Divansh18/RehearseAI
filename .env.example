# Deepgram and OpenAI text LLM keys are always required. Cartesia is required
# only when REHEARSE_TTS_PROVIDER=cartesia. Never put keys in browser code.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=

# Local server and session files.
REHEARSE_HOST=127.0.0.1
REHEARSE_PORT=7860
REHEARSE_SESSION_DIR=sessions
REHEARSE_PDF_DIR=private_pdfs
REHEARSE_SNAPSHOT_DIR=private_snapshots

# Deepgram STT and OpenAI text LLM.
REHEARSE_STT_MODEL=nova-3-general
# Static Nova-3 keyterm hints. Set empty to compare without hints.
# Do not add a candidate name here; use spoken correction for session facts.
REHEARSE_STT_KEYTERMS=RehearseAI,GrepAI,GitHub,webhooks
REHEARSE_LLM_MODEL=gpt-4.1-mini

# Cartesia streaming TTS is the default. OpenAI TTS remains selectable by
# setting REHEARSE_TTS_PROVIDER=openai; its settings below apply only then.
REHEARSE_TTS_PROVIDER=cartesia
REHEARSE_CARTESIA_TTS_MODEL=sonic-3.6
REHEARSE_CARTESIA_TTS_VOICE=db6b0ed5-d5d3-463d-ae85-518a07d3c2b4
REHEARSE_OPENAI_TTS_MODEL=gpt-4o-mini-tts
REHEARSE_OPENAI_TTS_VOICE=shimmer
REHEARSE_OPENAI_TTS_SPEED=1.0

# Turn settings; tune from real sessions, not from assumed latency.
REHEARSE_VAD_CONFIDENCE=0.7
REHEARSE_VAD_START_SECS=0.2
REHEARSE_VAD_STOP_SECS=0.35
REHEARSE_TURN_PAUSE_SECS=1.1

# Candidate accounts. Generate REHEARSE_AUTH_SECRET with:
# python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Never reuse the local secret in production.
REHEARSE_ENV=local
DATABASE_URL=postgresql+asyncpg://rehearse:rehearse_local_only@127.0.0.1:5433/rehearse_dev
REHEARSE_AUTH_SECRET=
REHEARSE_PUBLIC_BASE_URL=http://127.0.0.1:7860

# Password reset only: local Mailpit capture at http://127.0.0.1:8025.
# Registration/login do not send email; production reset needs real SMTP delivery.
REHEARSE_SMTP_HOST=127.0.0.1
REHEARSE_SMTP_PORT=1025
REHEARSE_SMTP_FROM=RehearseAI <no-reply@localhost>
REHEARSE_SMTP_USERNAME=
REHEARSE_SMTP_PASSWORD=
REHEARSE_SMTP_STARTTLS=false
